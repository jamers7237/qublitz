{
  "name": "schrodingers-home",
  "private": true,
  "version": "1.0.0",
  "description": "A 2D pixel-art quantum escape room driven by a real 8-qubit statevector simulator.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "experiments": "tsx scripts/run-experiments.ts",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "phaser": "3.90.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.49.1",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3",
    "vite": "^6.0.7",
    "vitest": "^3.0.0"
  }
}
